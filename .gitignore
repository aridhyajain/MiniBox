# Alpine root filesystem and download cache
rootfs/*
!rootfs/.gitkeep
.cache/

# Build outputs
build/
bin/
*.o
*.a
*.so
*.d
minibox

# Python
__pycache__/
*.pyc
.venv/
venv/
env/
.pytest_cache/

# Editor / OS
.vscode/
*.swp
.DS_Store

# Web UI
ui/venv/

# Benchmarks: keep only the chosen reference runs (bench/results/reference/ and older ones kept as
# bench/results/reference-<what>/, e.g. reference-before-clone3/)
bench/results/*
!bench/results/reference*/
